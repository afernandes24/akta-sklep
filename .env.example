# ─── Adres strony (bez ukośnika na końcu) ───────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Akta Detektywa

# ─── Supabase (Project Settings → API) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Klucz service_role – TYLKO po stronie serwera, nigdy z prefiksem NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ─── Płatności ──────────────────────────────────────────────────────
# mock | stripe | przelewy24
#  mock      – tryb testowy bez prawdziwych pieniędzy (tylko do testów!)
#  stripe    – Stripe Checkout (karty, BLIK, Przelewy24 przez Stripe)
#  przelewy24 – bezpośrednia integracja z Przelewy24
PAYMENT_PROVIDER=mock
# Zabezpieczenie: tryb "mock" na produkcji działa tylko, gdy ustawisz true
ALLOW_MOCK_PAYMENTS=false

# Stripe (Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# true = Stripe wystawia fakturę do każdej płatności i pozwala podać NIP (dodatkowo płatne w Stripe)
STRIPE_INVOICES=false

# Przelewy24 (Panel → Moje dane → Dane API)
P24_MERCHANT_ID=
P24_POS_ID=
P24_API_KEY=
P24_CRC=
# true = sandbox.przelewy24.pl, false = secure.przelewy24.pl
P24_SANDBOX=true

# ─── E-maile z potwierdzeniem zamówienia (https://resend.com) ───────
# Potwierdzenie na trwałym nośniku jest wymagane prawem przy sprzedaży PDF.
RESEND_API_KEY=
# np. "Akta Detektywa <zamowienia@twoja-domena.pl>" (domena zweryfikowana w Resend)
EMAIL_FROM=

# ─── Statystyki i reklamy (ładowane dopiero po zgodzie w banerze cookies) ───
# Google Analytics 4: Administracja → Strumienie danych → Identyfikator pomiaru (G-XXXXXXX)
NEXT_PUBLIC_GA_ID=
# Piksel Meta: Menedżer zdarzeń → Źródła danych → Identyfikator piksela
NEXT_PUBLIC_META_PIXEL_ID=

# ─── Kontakt ────────────────────────────────────────────────────────
NEXT_PUBLIC_CONTACT_EMAIL=
